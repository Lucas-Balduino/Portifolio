---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../../style.css';
import '../styles/tokens.css';
import '../styles/identity.css';
import defaultOgImage from '../../img/og-image.png?url';
import { SITE_NAME, absoluteUrl, canonicalUrl } from '../site-config';

interface Props {
	title?: string;
	description: string;
	ogImage?: string;
}

const { title = 'Lucas — Portfólio', description, ogImage } = Astro.props;
const currentPath = Astro.url.pathname;
const canonical = canonicalUrl(currentPath);
const ogImageAbs = ogImage ? absoluteUrl(ogImage) : absoluteUrl(defaultOgImage);
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageAbs} />
		<meta property="og:site_name" content={SITE_NAME} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonical} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageAbs} />

		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<script is:inline>
			(function () {
				try {
					if (localStorage.getItem('theme') === 'light') {
						document.body.classList.add('theme-light');
					}
				} catch (e) {}
			})();
		</script>
		<Header currentPath={currentPath} />
		<main class="container main-content">
			<slot />
		</main>
		<Footer />
		<script>
			const themeToggle = document.getElementById('theme-toggle');
			const isLight = document.body.classList.contains('theme-light');
			themeToggle?.setAttribute('aria-pressed', isLight ? 'false' : 'true');

			themeToggle?.addEventListener('click', () => {
				const light = document.body.classList.toggle('theme-light');
				localStorage.setItem('theme', light ? 'light' : 'dark');
				themeToggle.setAttribute('aria-pressed', light ? 'false' : 'true');
			});

			const burger = document.getElementById('nav-burger');
			const navList = document.getElementById('nav-list');
			if (burger && navList) {
				burger.addEventListener('click', () => {
					const expanded = burger.getAttribute('aria-expanded') === 'true';
					burger.setAttribute('aria-expanded', String(!expanded));
					navList.style.display = navList.style.display === 'flex' ? '' : 'flex';
					navList.style.flexDirection = 'column';
					navList.style.gap = '0.5rem';
					navList.style.background = 'var(--surface)';
					navList.style.padding = '0.8rem';
					navList.style.position = 'absolute';
					navList.style.right = '1rem';
					navList.style.top = '60px';
					navList.style.borderRadius = '8px';
					navList.style.boxShadow = '0 8px 20px rgba(0,0,0,0.08)';
				});
			}
		</script>
	</body>
</html>
