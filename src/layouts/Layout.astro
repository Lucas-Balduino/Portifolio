---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../../style.css';
import '../styles/tokens.css';
import '../styles/identity.css';
import defaultOgImage from '../../img/og-image.png?url';
import { SITE_NAME, absoluteUrl, canonicalUrl } from '../site-config';

interface Props {
	title?: string;
	description: string;
	ogImage?: string;
}

const { title = 'Lucas — Portfólio', description, ogImage } = Astro.props;
const currentPath = Astro.url.pathname;
const canonical = canonicalUrl(currentPath);
const ogImageAbs = ogImage ? absoluteUrl(ogImage) : absoluteUrl(defaultOgImage);
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageAbs} />
		<meta property="og:site_name" content={SITE_NAME} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonical} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageAbs} />

		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<script is:inline>
			(function () {
				try {
					if (localStorage.getItem('theme') === 'light') {
						document.body.classList.add('theme-light');
					}
				} catch (e) {}
			})();
		</script>
		<a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
		<Header currentPath={currentPath} />
		<main class="container main-content" id="conteudo" tabindex="-1">
			<slot />
		</main>
		<Footer />
		<script>
			// Tema: o botão é um interruptor "Tema escuro" (ligado = escuro).
			const themeToggle = document.getElementById('theme-toggle');
			const syncTheme = () => {
				const light = document.body.classList.contains('theme-light');
				themeToggle?.setAttribute('aria-checked', light ? 'false' : 'true');
			};
			syncTheme();

			themeToggle?.addEventListener('click', () => {
				const light = document.body.classList.toggle('theme-light');
				try {
					localStorage.setItem('theme', light ? 'light' : 'dark');
				} catch {}
				syncTheme();
			});

			// Cabeçalho ganha linha inferior depois de rolar.
			const header = document.querySelector<HTMLElement>('.site-header');
			const syncScrolled = () => header?.classList.toggle('is-scrolled', window.scrollY > 4);
			syncScrolled();
			window.addEventListener('scroll', syncScrolled, { passive: true });

			// Menu do celular: abre/fecha pelo botão, Esc, toque fora, ao navegar ou quando o foco sai.
			const burger = document.getElementById('nav-burger');
			if (header && burger) {
				const setOpen = (open: boolean) => {
					header.classList.toggle('is-open', open);
					burger.setAttribute('aria-expanded', String(open));
					burger.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
				};
				const isOpen = () => header.classList.contains('is-open');

				burger.addEventListener('click', () => setOpen(!isOpen()));
				document.addEventListener('keydown', (event) => {
					if (event.key === 'Escape' && isOpen()) {
						setOpen(false);
						burger.focus();
					}
				});
				document.addEventListener('click', (event) => {
					if (isOpen() && !header.contains(event.target as Node)) setOpen(false);
				});
				header.addEventListener('focusout', (event) => {
					if (isOpen() && !header.contains(event.relatedTarget as Node | null)) setOpen(false);
				});
				header.querySelectorAll('.nav-link').forEach((link) =>
					link.addEventListener('click', () => setOpen(false))
				);
				// Volta ao layout de computador: menu fechado.
				window.matchMedia('(min-width: 981px)').addEventListener('change', () => setOpen(false));
			}
		</script>
	</body>
</html>
