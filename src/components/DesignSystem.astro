---
interface Color {
	name: string;
	hex: string;
}

interface Font {
	role: string;
	family: string;
	weights?: string;
	webfont: boolean;
}

interface Props {
	heading: string;
	colors: Color[];
	fonts: Font[];
	link?: { href: string; label: string };
}

const { heading, colors, fonts, link } = Astro.props;

// Texto branco ou escuro conforme a luminância da cor (WCAG).
const textOn = (hex: string) => {
	const channel = (i: number) => {
		const value = parseInt(hex.slice(i, i + 2), 16) / 255;
		return value <= 0.03928 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4;
	};
	const luminance = 0.2126 * channel(1) + 0.7152 * channel(3) + 0.0722 * channel(5);
	return luminance > 0.4 ? '#111111' : '#ffffff';
};

// Só as famílias do Google Fonts são carregadas, e só nesta página.
const webFamilies = [...new Set(fonts.filter((font) => font.webfont).map((font) => font.family))];
const fontsHref = webFamilies.length
	? `https://fonts.googleapis.com/css2?${webFamilies
			.map((family) => `family=${family.replace(/ /g, '+')}:wght@400;700`)
			.join('&')}&display=swap`
	: '';
---

<section class="design-system" data-design-system>
	{fontsHref && <link rel="stylesheet" href={fontsHref} />}
	<h2>{heading}</h2>

	{
		colors.length > 0 && (
			<div class="ds-block">
				<h3>Cores</h3>
				<ul class="ds-colors">
					{colors.map((color) => {
						const hex = color.hex.toUpperCase();
						return (
							<li class="ds-color" style={`background:${hex};color:${textOn(hex)}`}>
								<span class="ds-color-name">{color.name}</span>
								<button
									type="button"
									class="ds-copy"
									data-hex={hex}
									aria-label={`Copiar ${hex} (${color.name})`}
								>
									<span class="ds-copy-label">{hex}</span>
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<rect x="9" y="9" width="11" height="11" rx="2" />
										<path d="M5 15V5a2 2 0 0 1 2-2h8" />
									</svg>
								</button>
							</li>
						);
					})}
				</ul>
			</div>
		)
	}

	{
		fonts.length > 0 && (
			<div class="ds-block">
				<h3>Tipografia</h3>
				<ul class="ds-fonts">
					{fonts.map((font) => (
						<li class="ds-font">
							<span class="ds-font-role">{font.role}</span>
							<p
								class="ds-font-name"
								style={font.webfont ? `font-family:'${font.family}', system-ui, sans-serif` : undefined}
							>
								{font.family}
							</p>
							{font.weights && <p class="ds-font-weights">{font.weights}</p>}
						</li>
					))}
				</ul>
			</div>
		)
	}

	{
		link && (
			<a class="btn ghost ds-link" href={link.href} target="_blank" rel="noopener noreferrer">
				{link.label} ↗
			</a>
		)
	}

	<p class="sr-only" aria-live="polite" data-copy-status></p>
</section>

<script>
	// Clipboard API quando disponível; senão, o método antigo via textarea.
	const copyText = async (text: string) => {
		try {
			await navigator.clipboard.writeText(text);
			return true;
		} catch {
			const field = document.createElement('textarea');
			field.value = text;
			field.setAttribute('readonly', '');
			field.style.position = 'fixed';
			field.style.opacity = '0';
			document.body.appendChild(field);
			field.select();
			const copied = document.execCommand('copy');
			field.remove();
			return copied;
		}
	};

	document.querySelectorAll<HTMLElement>('[data-design-system]').forEach((panel) => {
		const status = panel.querySelector<HTMLElement>('[data-copy-status]');
		panel.querySelectorAll<HTMLButtonElement>('.ds-copy').forEach((button) => {
			const label = button.querySelector<HTMLElement>('.ds-copy-label');
			const hex = button.dataset.hex ?? '';
			let timer: number | undefined;
			button.addEventListener('click', async () => {
				if (!(await copyText(hex))) return;
				if (label) label.textContent = 'Copiado!';
				if (status) status.textContent = `${hex} copiado`;
				window.clearTimeout(timer);
				timer = window.setTimeout(() => {
					if (label) label.textContent = hex;
				}, 1500);
			});
		});
	});
</script>

<style>
	.design-system {
		margin: 2rem 0;
		padding: 1.5rem;
		border-radius: 12px;
		background: var(--surface);
	}

	.design-system h2 {
		margin: 0 0 1.25rem;
		font-size: 1.5rem;
		color: var(--accent);
	}

	.ds-block + .ds-block {
		margin-top: 1.75rem;
	}

	.ds-block h3 {
		margin: 0 0 0.75rem;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.ds-colors,
	.ds-fonts {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.ds-colors {
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 140px), 1fr));
	}

	.ds-fonts {
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
	}

	.ds-color {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1rem;
		min-height: 6.5rem;
		padding: 0.9rem 1rem;
		border-radius: 14px;
		border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);
	}

	.ds-color-name {
		font-size: 0.85rem;
		font-weight: 700;
		line-height: 1.3;
	}

	.ds-copy {
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		width: 100%;
		padding: 0.35rem 0.5rem;
		border: 0;
		border-radius: 8px;
		background: color-mix(in srgb, currentColor 14%, transparent);
		color: inherit;
		font: inherit;
		font-size: 0.8rem;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		cursor: copy;
		transition: background var(--transition);
	}

	.ds-copy:hover {
		background: color-mix(in srgb, currentColor 24%, transparent);
	}

	.ds-copy:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}

	.ds-copy svg {
		width: 0.95rem;
		height: 0.95rem;
		flex-shrink: 0;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.ds-font {
		display: flex;
		flex-direction: column;
		padding: 1rem;
		border-radius: 14px;
		background: color-mix(in srgb, var(--text) 5%, transparent);
	}

	.ds-font-role {
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--muted);
	}

	.ds-font-name {
		margin: 1.25rem 0 0;
		font-size: 1.75rem;
		font-weight: 700;
		line-height: 1.15;
		color: var(--text);
	}

	.ds-font-weights {
		margin: 0.4rem 0 0;
		font-size: 0.8rem;
		color: var(--muted);
	}

	.ds-link {
		margin-top: 1.5rem;
	}
</style>
