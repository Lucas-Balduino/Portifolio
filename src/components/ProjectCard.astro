---
interface Props {
	title: string;
	slug: string;
	shortDesc: string;
	image: string;
	technologies: string[];
	repoUrl: string;
	liveUrl: string;
}

const { title, slug, shortDesc, image, technologies, repoUrl, liveUrl } = Astro.props;

const imageUrls = import.meta.glob<{ default: string }>('../../img/**/*.{png,jpg,jpeg}', {
	eager: true,
	query: '?url',
	import: 'default'
});

const resolveImage = (posixPath: string) => {
	const match = Object.entries(imageUrls).find(([key]) =>
		key.replace(/\\/g, '/').endsWith(`/${posixPath}`)
	);
	return match?.[1] ?? '';
};

const imageSrc = resolveImage(image) || resolveImage('img/ImagemEmDesenvolvimento.jpg');
const githubHref = repoUrl.trim();
const liveHref = liveUrl.trim();
const detailHref = slug.trim() ? `/projetos/${slug}` : '';
---

<article class="card project-card">
	<img class="card-media" src={imageSrc} alt={`${title} screenshot`} loading="lazy" />
	<div class="card-body">
		<h3 class="card-title">{title}</h3>
		<p class="card-desc">{shortDesc}</p>
		{
			technologies.length > 0 && (
				<div class="card-tags">
					{technologies.map((tech) => (
						<span class="badge">{tech}</span>
					))}
				</div>
			)
		}
		{
			(githubHref || liveHref || detailHref) && (
				<div class="card-actions">
					{githubHref ? (
						<a class="card-link" href={githubHref} target="_blank" rel="noopener noreferrer">
							GitHub
						</a>
					) : null}
					{liveHref ? (
						<a class="card-link" href={liveHref} target="_blank" rel="noopener noreferrer">
							Live Demo
						</a>
					) : null}
					{detailHref ? (
						<a class="card-link card-link--primary" href={detailHref}>
							Ver detalhes
						</a>
					) : null}
				</div>
			)
		}
	</div>
</article>
