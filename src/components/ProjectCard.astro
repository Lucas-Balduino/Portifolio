---
import TechList from './TechList.astro';
import type { HoverScreen } from '../lib/projects';
import { BLANK_IMAGE, containedImage, responsiveImage } from '../lib/images';

interface Props {
	title: string;
	slug: string;
	shortDesc: string;
	image: string;
	technologies: string[];
	/** Linha curta acima do título, ex.: "Projeto acadêmico · 2026.1". */
	meta?: string;
	/** D2: frase de resultado do autor; quando existir, substitui a descrição curta. */
	outcome?: string;
	/** Card em destaque: ocupa a linha inteira, imagem ao lado do texto. */
	featured?: boolean;
	/** F3 — telas do projeto, mostradas no hover (só com mouse). */
	screen?: HoverScreen;
}

const { title, slug, shortDesc, image, technologies, meta, outcome, featured = false, screen } =
	Astro.props;
const description = outcome && outcome.trim() && outcome.trim() !== 'pendente' ? outcome : shortDesc;

// Card de /projetos: 2 por linha (~540px), 1 por linha no celular.
const cover = await responsiveImage(
	image,
	[480, 800, 1200],
	'(max-width: 700px) calc(100vw - 48px), 540px'
);
// Capa com as telas: mesmo tamanho da capa. Tela solta: inteira na caixa de 540×304 menos 16px de respiro.
const screenImage = screen
	? screen.full
		? await responsiveImage(screen.src, [480, 800, 1200], cover.sizes)
		: await containedImage(screen.src, 508, 272)
	: undefined;
---

<!-- O card inteiro é o link para o case; GitHub e demo ficam na ficha do case. -->
<a class:list={['project-card', { 'project-card--featured': featured }]} href={`/projetos/${slug}`}>
	<div class="project-card-media" data-reveal>
		<img
			transition:name={`capa-${slug}`}
			src={cover.src}
			srcset={cover.srcset}
			sizes={cover.sizes}
			width={cover.width}
			height={cover.height}
			alt=""
			loading={featured ? 'eager' : 'lazy'}
			decoding="async"
		/>
		{
			screenImage && (
				<picture>
					<source
						media="(hover: hover) and (pointer: fine)"
						srcset={screenImage.srcset}
						sizes={screenImage.sizes}
					/>
					<img
						class:list={['project-card-screen', { 'project-card-screen--full': screen?.full }]}
						src={BLANK_IMAGE}
						width={screenImage.width}
						height={screenImage.height}
						alt=""
						loading="lazy"
						decoding="async"
					/>
				</picture>
			)
		}
	</div>
	<div class="project-card-body">
		{meta && <p class="project-card-meta">{meta}</p>}
		<h3 class="project-card-title">{title}</h3>
		<p class="project-card-desc">{description}</p>
		{
			technologies.length > 0 && (
				<TechList technologies={technologies} variant="card" limit={featured ? 4 : 3} />
			)
		}
		<span class="project-card-cta" aria-hidden="true">Ver case →</span>
	</div>
</a>

<style>
	.project-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border-radius: 8px;
		background: var(--surface);
		border: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
		color: inherit;
		text-decoration: none;
		transition:
			transform var(--transition),
			border-color var(--transition),
			box-shadow var(--transition);
	}

	.project-card:hover {
		border-color: color-mix(in srgb, var(--text) 22%, transparent);
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.18);
	}

	.project-card:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.project-card-media {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		background: color-mix(in srgb, var(--text) 5%, transparent);
	}

	.project-card-media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* F3 — no hover, a capa dá lugar a uma segunda tela do projeto, inteira. Sem mouse, o <source> não
	   vale e fica o GIF vazio do src: a tela nem é baixada. */
	.project-card-media .project-card-screen {
		display: none;
		position: absolute;
		inset: 0;
		padding: var(--space-4);
		object-fit: contain;
		background: var(--surface);
		opacity: 0;
		transition: opacity 300ms ease-out;
	}

	.project-card-media .project-card-screen--full {
		padding: 0;
		object-fit: cover;
	}

	@media (hover: hover) and (pointer: fine) {
		.project-card-media .project-card-screen {
			display: block;
		}

		.project-card:hover .project-card-screen {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project-card-media .project-card-screen {
			transition: none;
		}
	}

	.project-card-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: var(--space-3);
		padding: var(--space-5);
	}

	.project-card-meta {
		margin: 0;
		font-size: var(--text-sm);
		font-weight: 500;
		color: var(--muted);
	}

	.project-card-title {
		margin: 0;
		font-size: var(--text-lg);
		letter-spacing: var(--tracking-title);
		line-height: var(--leading-title);
		color: var(--text);
	}

	.project-card-desc {
		margin: 0;
		line-height: 1.55;
		color: var(--muted);
	}

	.project-card-cta {
		margin-top: auto;
		padding-top: var(--space-2);
		font-size: var(--text-sm);
		font-weight: 700;
		color: var(--text);
	}

	.project-card:hover .project-card-cta {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	@media (min-width: 760px) {
		.project-card--featured {
			display: grid;
			grid-column: 1 / -1;
			grid-template-columns: 1.15fr 1fr;
		}

		.project-card--featured .project-card-media {
			aspect-ratio: auto;
			min-height: 340px;
		}

		.project-card--featured .project-card-body {
			justify-content: center;
			padding: var(--space-6);
		}

		.project-card--featured .project-card-title {
			font-size: var(--text-xl);
			letter-spacing: var(--tracking-heading);
			line-height: var(--leading-heading);
		}
	}
</style>
