---
import TechList from './TechList.astro';
import type { HoverScreen } from '../lib/projects';
import { splitTechnologies } from '../lib/technologies';
import { BLANK_IMAGE, containedImage, responsiveImage } from '../lib/images';

/** C4 — projeto da home em linha grande: capa larga de um lado, texto do outro. */
interface Props {
	title: string;
	slug: string;
	description: string;
	image: string;
	technologies: string[];
	/** Linha curta acima do título, ex.: "Projeto acadêmico · 2026.1". */
	meta?: string;
	/** Capa à direita (as linhas alternam o lado). */
	reverse?: boolean;
	/** Primeira linha: capa carrega sem esperar a rolagem. */
	eager?: boolean;
	/** F3 — telas do projeto, mostradas no hover (só com mouse). */
	screen?: HoverScreen;
}

const {
	title,
	slug,
	description,
	image,
	technologies,
	meta,
	reverse = false,
	eager = false,
	screen
} = Astro.props;

// Só 2–3 ferramentas; as competências ficam no case.
const tools = splitTechnologies(technologies)
	.tools.slice(0, 3)
	.map((tool) => tool.label);
// Capa em 2/3 da largura (~700px); no celular, a largura toda.
const cover = await responsiveImage(
	image,
	[480, 800, 1200, 1600],
	'(max-width: 760px) calc(100vw - 48px), 700px'
);
// Capa com as telas: mesmo tamanho da capa. Tela solta: inteira na caixa de 700×437 menos 16px de respiro.
const screenImage = screen
	? screen.full
		? await responsiveImage(screen.src, [480, 800, 1200, 1600], cover.sizes)
		: await containedImage(screen.src, 668, 405)
	: undefined;
---

<a class:list={['project-row', { 'project-row--reverse': reverse }]} href={`/projetos/${slug}`}>
	<div class="project-row-media" data-reveal>
		<img
			transition:name={`capa-${slug}`}
			src={cover.src}
			srcset={cover.srcset}
			sizes={cover.sizes}
			alt=""
			width={cover.width}
			height={cover.height}
			fetchpriority={eager ? 'high' : undefined}
			loading={eager ? 'eager' : 'lazy'}
			decoding="async"
		/>
		{
			screenImage && (
				<picture>
					<source
						media="(hover: hover) and (pointer: fine)"
						srcset={screenImage.srcset}
						sizes={screenImage.sizes}
					/>
					<img
						class:list={['project-row-screen', { 'project-row-screen--full': screen?.full }]}
						src={BLANK_IMAGE}
						width={screenImage.width}
						height={screenImage.height}
						alt=""
						loading="lazy"
						decoding="async"
					/>
				</picture>
			)
		}
	</div>
	<div class="project-row-text">
		{meta && <p class="project-row-meta">{meta}</p>}
		<h3 class="project-row-title">{title}</h3>
		<p class="project-row-desc">{description}</p>
		{tools.length > 0 && <TechList technologies={tools} variant="tools" />}
		<span class="project-row-cta" aria-hidden="true">Ver case →</span>
	</div>
</a>

<style>
	.project-row {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
		align-items: center;
		gap: var(--space-7);
		color: inherit;
		text-decoration: none;
	}

	.project-row--reverse {
		grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
	}

	.project-row--reverse .project-row-media {
		order: 2;
	}

	/* Capa em 16:10, a proporção do molde de capas (C1). */
	.project-row-media {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 10;
		border-radius: 8px;
		border: 1px solid var(--line);
		background: var(--surface);
	}

	.project-row-media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* F3 — no hover, a capa dá lugar a uma segunda tela do projeto, inteira. Sem mouse, o <source> não
	   vale e fica o GIF vazio do src: a tela nem é baixada. */
	.project-row-media .project-row-screen {
		display: none;
		position: absolute;
		inset: 0;
		padding: var(--space-4);
		object-fit: contain;
		background: var(--surface);
		opacity: 0;
		transition: opacity 300ms ease-out;
	}

	.project-row-media .project-row-screen--full {
		padding: 0;
		object-fit: cover;
	}

	@media (hover: hover) and (pointer: fine) {
		.project-row-media .project-row-screen {
			display: block;
		}

		.project-row:hover .project-row-screen {
			opacity: 1;
		}
	}

	.project-row-text {
		display: grid;
		justify-items: start;
		gap: var(--space-3);
	}

	.project-row-meta {
		margin: 0;
		font-size: var(--text-sm);
		font-weight: 500;
		color: var(--muted);
	}

	.project-row-title {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 700;
		line-height: var(--leading-heading);
		letter-spacing: var(--tracking-heading);
		color: var(--text);
	}

	.project-row-desc {
		margin: 0 0 var(--space-1);
		line-height: 1.6;
		color: var(--muted);
	}

	.project-row-cta {
		margin-top: var(--space-2);
		font-weight: 600;
		color: var(--text);
	}

	.project-row:hover .project-row-cta {
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.project-row:focus-visible {
		outline-offset: 6px;
		border-radius: 8px;
	}

	@media (max-width: 760px) {
		.project-row,
		.project-row--reverse {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-5);
		}

		.project-row--reverse .project-row-media {
			order: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project-row-media .project-row-screen {
			transition: none;
		}
	}
</style>
