---
import TechList from './TechList.astro';

type Summary = Partial<
	Record<'type' | 'context' | 'period' | 'role' | 'team' | 'advisor' | 'deliverable', string>
>;

interface Props {
	summary?: Summary;
	technologies: string[];
}

const { summary = {}, technologies } = Astro.props;

const isFilled = (value?: string) => Boolean(value && value.trim() && value.trim() !== 'pendente');

// "Meu papel" fica em destaque à esquerda; o resto, em campos curtos ao lado.
const role = isFilled(summary.role) ? summary.role : undefined;
const fields = [
	{ key: 'type', label: 'Tipo', wide: false },
	{ key: 'period', label: 'Período', wide: false },
	{ key: 'context', label: 'Contexto', wide: false },
	{ key: 'advisor', label: 'Orientação', wide: false },
	{ key: 'team', label: 'Equipe', wide: true },
	{ key: 'deliverable', label: 'Entrega', wide: true }
] as const;

const visibleFields = fields.filter((field) => isFilled(summary[field.key]));
---

<section class:list={['case-summary', { 'case-summary--split': role }]} aria-label="Ficha do projeto">
	{
		role && (
			<div class="summary-role">
				<p class="summary-label">Meu papel</p>
				<p class="summary-role-text">{role}</p>
			</div>
		)
	}

	{
		visibleFields.length > 0 && (
			<dl class="summary-grid">
				{visibleFields.map((field) => (
					<div class:list={['summary-item', { 'summary-item--wide': field.wide }]}>
						<dt class="summary-label">{field.label}</dt>
						<dd>{summary[field.key]}</dd>
					</div>
				))}
			</dl>
		)
	}

	<div class="summary-tools">
		<TechList technologies={technologies} variant="tools" />
	</div>
</section>

<style>
	.case-summary {
		display: grid;
		gap: var(--space-5);
		margin: var(--space-6) 0 0;
		padding: var(--space-5);
		border-radius: 8px;
		background: var(--surface);
		border: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
	}

	.summary-label {
		margin: 0 0 var(--space-1);
		font-size: var(--text-xs);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--muted);
	}

	/* A pergunta nº 1 de quem contrata: o que eu fiz. */
	.summary-role-text {
		margin: 0;
		font-size: var(--text-md);
		font-weight: 500;
		line-height: 1.45;
		letter-spacing: -0.01em;
		color: var(--text);
		text-wrap: pretty;
	}

	.summary-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-4) var(--space-5);
		margin: 0;
	}

	.summary-item--wide {
		grid-column: 1 / -1;
	}

	.summary-item dd {
		margin: 0;
		font-size: var(--text-sm);
		line-height: 1.5;
		color: var(--text);
	}

	.summary-tools {
		padding-top: var(--space-4);
		border-top: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
	}

	/* Computador: papel numa coluna, campos na outra; ferramentas na linha de baixo. */
	@media (min-width: 820px) {
		.case-summary--split {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			column-gap: var(--space-7);
		}

		.case-summary--split .summary-tools {
			grid-column: 1 / -1;
		}
	}
</style>
