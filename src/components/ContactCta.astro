---
/**
 * C5 — fechamento da home, do Sobre e de cada case: título grande, email com copiar e os chamados.
 * Com `page`, vira o conteúdo da página de Contato (E2): título h1, sem linha em cima e sem o
 * botão que leva à própria página.
 */
interface Props {
	text?: string;
	page?: boolean;
}

const { text = 'Sobre uma vaga, um projeto ou algum dos cases acima.', page = false } = Astro.props;
const email = 'lucasgbalduino@gmail.com';
const Heading = page ? 'h1' : 'h2';
---

<section class:list={['contact-cta', { 'contact-cta--page': page }]}>
	<Heading>{page ? 'Contato' : 'Vamos conversar?'}</Heading>
	<p class="contact-cta-text">{text}</p>
	<div class="contact-cta-row">
		<p class="contact-email">
			<a href={`mailto:${email}`}>{email}</a>
			<button
				type="button"
				class="contact-copy"
				data-copy={email}
				data-tip="Copiar"
				aria-label="Copiar email"
			>
				<svg
					class="icon-copy"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
					><rect x="9" y="9" width="13" height="13" rx="2"></rect><path
						d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg
				>
				<svg
					class="icon-check"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg
				>
			</button>
		</p>
		<div class="contact-cta-actions">
			{!page && <a class="btn-project" href="/contato">Entrar em contato</a>}
			<a
				class="btn ghost"
				href="https://www.linkedin.com/in/lucas-balduino-661073327"
				target="_blank"
				rel="noopener noreferrer">LinkedIn</a
			>
			<a
				class="btn ghost"
				href="https://github.com/Lucas-Balduino"
				target="_blank"
				rel="noopener noreferrer">GitHub</a
			>
		</div>
	</div>
</section>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('.contact-copy')) {
		let timer: number | undefined;
		button.addEventListener('click', async () => {
			const value = button.dataset.copy ?? '';
			try {
				await navigator.clipboard.writeText(value);
			} catch {
				// Sem acesso à área de transferência (ex.: http): copia por seleção.
				const area = document.createElement('textarea');
				area.value = value;
				area.style.position = 'fixed';
				area.style.opacity = '0';
				document.body.append(area);
				area.select();
				const ok = document.execCommand('copy');
				area.remove();
				if (!ok) return;
			}
			button.dataset.tip = 'Copiado';
			button.setAttribute('aria-label', 'Email copiado');
			button.toggleAttribute('data-copied', true);
			window.clearTimeout(timer);
			timer = window.setTimeout(() => {
				button.dataset.tip = 'Copiar';
				button.setAttribute('aria-label', 'Copiar email');
				button.toggleAttribute('data-copied', false);
			}, 2000);
		});
	}
</script>

<style>
	.contact-cta {
		margin: var(--rhythm-section) 0 var(--space-6);
		padding-top: var(--space-8);
		border-top: 1px solid var(--line);
	}

	.contact-cta--page {
		margin: 0;
		padding-top: 0;
		border-top: 0;
	}

	/* Na página estreita de Contato, email e botões empilhados em vez de nas pontas da coluna. */
	.contact-cta--page .contact-cta-row {
		flex-direction: column;
		align-items: flex-start;
	}

	.contact-cta h1,
	.contact-cta h2 {
		margin: 0 0 var(--space-3);
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 700;
		line-height: var(--leading-heading);
		letter-spacing: var(--tracking-heading);
	}

	/* Fechamento: menor que o título da página (24–36px), para não competir com o conteúdo acima. */
	.contact-cta h2 {
		font-size: clamp(var(--text-lg), 1.2rem + 1.5vw, 2.25rem);
	}

	.contact-cta-text {
		margin: 0 0 var(--space-6);
		font-size: var(--text-md);
		color: var(--muted);
	}

	.contact-cta-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-5);
	}

	.contact-email {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		min-width: 0;
		margin: 0;
		font-size: var(--text-lg);
		font-weight: 600;
		letter-spacing: var(--tracking-title);
	}

	.contact-email a {
		min-width: 0;
		overflow-wrap: anywhere;
		color: var(--text);
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--text) 30%, transparent);
		text-underline-offset: 6px;
		transition: text-decoration-color 200ms ease;
	}

	.contact-email a:hover {
		text-decoration-color: var(--text);
	}

	/* Copiar: ícone com dica no hover, igual aos blocos de código. */
	.contact-copy {
		position: relative;
		display: grid;
		flex: none;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		border-radius: 6px;
		background: transparent;
		color: var(--muted);
		cursor: pointer;
		transition:
			color 150ms ease,
			background-color 150ms ease,
			transform 160ms ease-out;
	}

	.contact-copy:hover,
	.contact-copy:focus-visible,
	.contact-copy[data-copied] {
		color: var(--text);
		background: color-mix(in srgb, var(--text) 10%, transparent);
	}

	.contact-copy:active {
		transform: scale(0.97);
	}

	.contact-copy svg {
		width: 18px;
		height: 18px;
	}

	.icon-check,
	.contact-copy[data-copied] .icon-copy {
		display: none;
	}

	.contact-copy[data-copied] .icon-check {
		display: block;
	}

	.contact-copy::after {
		content: attr(data-tip);
		position: absolute;
		bottom: calc(100% + 6px);
		left: 50%;
		padding: var(--space-1) var(--space-2);
		border-radius: 4px;
		background: var(--text);
		color: var(--bg);
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: 0;
		white-space: nowrap;
		pointer-events: none;
		opacity: 0;
		transform: translate(-50%, 4px);
		transition:
			opacity 150ms ease,
			transform 150ms ease;
	}

	.contact-copy:hover::after,
	.contact-copy:focus-visible::after,
	.contact-copy[data-copied]::after {
		opacity: 1;
		transform: translate(-50%, 0);
	}

	.contact-cta-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
	}

	@media (max-width: 640px) {
		.contact-email {
			font-size: var(--text-md);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-copy,
		.contact-copy::after {
			transition: none;
		}
	}
</style>
