---
interface Props {
	title: string;
	heading: string;
	images: string[];
}

const { title, heading, images } = Astro.props;
const total = images.length;
const publicSrc = (posixPath: string) => `/${posixPath.replace(/^\/+/, '')}`;
---

<section class="project-images" data-gallery>
	<h2>{heading}</h2>
	<div class="project-images-grid">
		{
			images.map((src, index) => (
				<figure class="project-shot">
					<button
						type="button"
						class="shot-trigger"
						data-index={index}
						aria-label={`Ampliar imagem ${index + 1} de ${total}`}
					>
						<img
							src={publicSrc(src)}
							alt={`${title} — imagem ${index + 1} de ${total}`}
							loading="lazy"
						/>
					</button>
				</figure>
			))
		}
	</div>

	<dialog class="lightbox" aria-label={`Galeria — ${title}`}>
		<div class="lightbox-stage">
			<img class="lightbox-img" src="" alt="" />
		</div>
		<p class="lightbox-counter" aria-live="polite"></p>
		<button type="button" class="lightbox-btn lightbox-close" aria-label="Fechar galeria">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
		</button>
		{
			total > 1 && (
				<>
					<button type="button" class="lightbox-btn lightbox-prev" aria-label="Imagem anterior">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
					</button>
					<button type="button" class="lightbox-btn lightbox-next" aria-label="Próxima imagem">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
					</button>
				</>
			)
		}
	</dialog>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
		const triggers = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.shot-trigger'));
		const thumbs = triggers.map((trigger) => trigger.querySelector('img')!);
		const dialog = gallery.querySelector<HTMLDialogElement>('.lightbox');
		const stage = gallery.querySelector<HTMLElement>('.lightbox-stage');
		const image = gallery.querySelector<HTMLImageElement>('.lightbox-img');
		const counter = gallery.querySelector<HTMLElement>('.lightbox-counter');
		if (!dialog || !stage || !image || !counter) return;

		// Imagens horizontais ocupam duas colunas na grade.
		thumbs.forEach((thumb) => {
			const tagOrientation = () => {
				const figure = thumb.closest('.project-shot');
				if (!(figure instanceof HTMLElement) || !thumb.naturalWidth) return;
				figure.classList.toggle('is-landscape', thumb.naturalWidth > thumb.naturalHeight);
				figure.classList.toggle('is-portrait', thumb.naturalWidth <= thumb.naturalHeight);
			};
			if (thumb.complete) tagOrientation();
			else thumb.addEventListener('load', tagOrientation, { once: true });
		});

		let current = 0;
		let lastTrigger: HTMLButtonElement | null = null;

		const show = (index: number) => {
			current = (index + thumbs.length) % thumbs.length;
			const thumb = thumbs[current];
			image.src = thumb.currentSrc || thumb.src;
			image.alt = thumb.alt;
			counter.textContent = `${current + 1} / ${thumbs.length}`;
			// Pré-carrega as vizinhas para a navegação não piscar.
			[current - 1, current + 1].forEach((i) => {
				const neighbor = thumbs[(i + thumbs.length) % thumbs.length];
				if (neighbor) new Image().src = neighbor.src;
			});
		};

		triggers.forEach((trigger, index) => {
			trigger.addEventListener('click', () => {
				lastTrigger = trigger;
				show(index);
				dialog.showModal();
			});
		});

		// Imagens dos cards do case abrem a mesma galeria, na posição da imagem.
		document.querySelectorAll<HTMLButtonElement>('[data-open-in-gallery]').forEach((button) => {
			const index = thumbs.findIndex(
				(thumb) => thumb.getAttribute('src') === button.dataset.openInGallery
			);
			if (index === -1) return;
			button.addEventListener('click', () => {
				lastTrigger = button;
				show(index);
				dialog.showModal();
			});
		});

		gallery.querySelector('.lightbox-prev')?.addEventListener('click', () => show(current - 1));
		gallery.querySelector('.lightbox-next')?.addEventListener('click', () => show(current + 1));
		gallery.querySelector('.lightbox-close')?.addEventListener('click', () => dialog.close());

		dialog.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') show(current - 1);
			if (event.key === 'ArrowRight') show(current + 1);
		});

		// Clicar fora da imagem fecha.
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog || event.target === stage) dialog.close();
		});

		dialog.addEventListener('close', () => lastTrigger?.focus());

		// Deslizar no celular.
		let startX: number | null = null;
		stage.addEventListener('pointerdown', (event) => {
			startX = event.clientX;
		});
		stage.addEventListener('pointerup', (event) => {
			if (startX === null) return;
			const deltaX = event.clientX - startX;
			startX = null;
			if (Math.abs(deltaX) > 50) show(current + (deltaX < 0 ? 1 : -1));
		});
	});
</script>

<style>
	.shot-trigger {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		padding: 0;
		border: 0;
		border-radius: 6px;
		background: none;
		cursor: zoom-in;
	}

	.shot-trigger img {
		transition: transform var(--transition);
	}

	.shot-trigger:hover img {
		transform: scale(1.02);
	}

	.shot-trigger:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}

	.lightbox {
		width: 100vw;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: #fff;
		overflow: hidden;
	}

	.lightbox::backdrop {
		background: rgba(0, 0, 0, 0.95);
	}

	.lightbox-stage {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		padding: 4rem 4.5rem;
		box-sizing: border-box;
		touch-action: pan-y;
	}

	.lightbox-img {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
		border-radius: 6px;
		user-select: none;
		-webkit-user-drag: none;
	}

	.lightbox-counter {
		position: absolute;
		top: 1.25rem;
		left: 1.5rem;
		margin: 0;
		font-size: 0.9rem;
		font-weight: 600;
		color: rgba(255, 255, 255, 0.75);
	}

	.lightbox-btn {
		position: absolute;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 0;
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.12);
		color: #fff;
		cursor: pointer;
		transition: background var(--transition);
	}

	.lightbox-btn:hover {
		background: rgba(255, 255, 255, 0.24);
	}

	.lightbox-btn:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 2px;
	}

	.lightbox-btn svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.lightbox-close {
		top: 0.75rem;
		right: 0.75rem;
	}

	.lightbox-prev,
	.lightbox-next {
		top: 50%;
		transform: translateY(-50%);
	}

	.lightbox-prev {
		left: 0.75rem;
	}

	.lightbox-next {
		right: 0.75rem;
	}

	@media (max-width: 640px) {
		.lightbox-stage {
			padding: 3.75rem 0.75rem 5rem;
		}

		.lightbox-prev,
		.lightbox-next {
			top: auto;
			bottom: 1rem;
			transform: none;
		}

		.lightbox-prev {
			left: calc(50% - 3.25rem);
		}

		.lightbox-next {
			right: calc(50% - 3.25rem);
		}
	}

	:global(html:has(dialog.lightbox[open])) {
		overflow: hidden;
	}
</style>
