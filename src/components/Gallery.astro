---
import { imageSize } from '../lib/image-size';

interface Props {
	id?: string;
	title: string;
	heading: string;
	images: { src: string; caption?: string }[];
}

const { id, title, heading, images } = Astro.props;
const total = images.length;
const publicSrc = (posixPath: string) => `/${posixPath.replace(/^\/+/, '')}`;
const shots = images.map(({ src, caption }, index) => ({
	src: publicSrc(src),
	caption,
	alt: caption ?? `${title} — tela ${index + 1} de ${total}`,
	size: imageSize(src)
}));
---

<section class="project-images" id={id} data-gallery>
	<div class="shots-head">
		<h2>{heading}</h2>
		{
			total > 1 && (
				<div class="shots-nav">
					<button type="button" class="shots-btn" data-shots-prev aria-label="Telas anteriores">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
					</button>
					<button type="button" class="shots-btn" data-shots-next aria-label="Próximas telas">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
					</button>
				</div>
			)
		}
	</div>
	<div class="shots" tabindex="0" role="region" aria-label={`${heading}: role para o lado para ver mais`}>
		{
			shots.map((shot, index) => (
				<figure class="shot">
					<button
						type="button"
						class="shot-trigger"
						data-index={index}
						aria-label={`Ampliar: ${shot.alt}`}
					>
						<img
							src={shot.src}
							alt={shot.alt}
							width={shot.size?.width}
							height={shot.size?.height}
							loading="lazy"
							decoding="async"
						/>
					</button>
					{shot.caption && <figcaption>{shot.caption}</figcaption>}
				</figure>
			))
		}
	</div>

	<dialog class="lightbox" aria-label={`Galeria — ${title}`}>
		<div class="lightbox-stage">
			<img class="lightbox-img" src="" alt="" />
		</div>
		<p class="lightbox-counter" aria-live="polite"></p>
		<button type="button" class="lightbox-btn lightbox-close" aria-label="Fechar galeria">
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
		</button>
		{
			total > 1 && (
				<>
					<button type="button" class="lightbox-btn lightbox-prev" aria-label="Imagem anterior">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
					</button>
					<button type="button" class="lightbox-btn lightbox-next" aria-label="Próxima imagem">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
					</button>
				</>
			)
		}
	</dialog>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
		const triggers = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.shot-trigger'));
		const thumbs = triggers.map((trigger) => trigger.querySelector('img')!);
		const dialog = gallery.querySelector<HTMLDialogElement>('.lightbox');
		const stage = gallery.querySelector<HTMLElement>('.lightbox-stage');
		const image = gallery.querySelector<HTMLImageElement>('.lightbox-img');
		const counter = gallery.querySelector<HTMLElement>('.lightbox-counter');
		if (!dialog || !stage || !image || !counter) return;

		let current = 0;
		let lastTrigger: HTMLButtonElement | null = null;

		const show = (index: number) => {
			current = (index + thumbs.length) % thumbs.length;
			const thumb = thumbs[current];
			image.src = thumb.currentSrc || thumb.src;
			image.alt = thumb.alt;
			const caption = thumb.closest('figure')?.querySelector('figcaption')?.textContent;
			counter.textContent = `${current + 1} / ${thumbs.length}${caption ? ` · ${caption}` : ''}`;
			// Pré-carrega as vizinhas para a navegação não piscar.
			[current - 1, current + 1].forEach((i) => {
				const neighbor = thumbs[(i + thumbs.length) % thumbs.length];
				if (neighbor) new Image().src = neighbor.src;
			});
		};

		triggers.forEach((trigger, index) => {
			trigger.addEventListener('click', () => {
				lastTrigger = trigger;
				show(index);
				dialog.showModal();
			});
		});

		// Imagens dos cards do case abrem a mesma galeria, na posição da imagem.
		document.querySelectorAll<HTMLButtonElement>('[data-open-in-gallery]').forEach((button) => {
			const index = thumbs.findIndex(
				(thumb) => thumb.getAttribute('src') === button.dataset.openInGallery
			);
			if (index === -1) return;
			button.addEventListener('click', () => {
				lastTrigger = button;
				show(index);
				dialog.showModal();
			});
		});

		gallery.querySelector('.lightbox-prev')?.addEventListener('click', () => show(current - 1));
		gallery.querySelector('.lightbox-next')?.addEventListener('click', () => show(current + 1));
		gallery.querySelector('.lightbox-close')?.addEventListener('click', () => dialog.close());

		dialog.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') show(current - 1);
			if (event.key === 'ArrowRight') show(current + 1);
		});

		// Clicar fora da imagem fecha.
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog || event.target === stage) dialog.close();
		});

		dialog.addEventListener('close', () => lastTrigger?.focus());

		// Deslizar no celular.
		let startX: number | null = null;
		stage.addEventListener('pointerdown', (event) => {
			startX = event.clientX;
		});
		stage.addEventListener('pointerup', (event) => {
			if (startX === null) return;
			const deltaX = event.clientX - startX;
			startX = null;
			if (Math.abs(deltaX) > 50) show(current + (deltaX < 0 ? 1 : -1));
		});

		// Faixa de telas: setas rolam quase uma largura; somem nas pontas.
		const strip = gallery.querySelector<HTMLElement>('.shots');
		const prev = gallery.querySelector<HTMLButtonElement>('[data-shots-prev]');
		const next = gallery.querySelector<HTMLButtonElement>('[data-shots-next]');
		if (strip && prev && next) {
			const step = (direction: number) =>
				strip.scrollBy({ left: direction * strip.clientWidth * 0.8, behavior: 'smooth' });
			prev.addEventListener('click', () => step(-1));
			next.addEventListener('click', () => step(1));
			const update = () => {
				const max = strip.scrollWidth - strip.clientWidth;
				prev.disabled = strip.scrollLeft <= 4;
				next.disabled = strip.scrollLeft >= max - 4;
				gallery.classList.toggle('is-scrollable', max > 4);
			};
			strip.addEventListener('scroll', update, { passive: true });
			new ResizeObserver(update).observe(strip);
			update();
		}
	});
</script>

<style>
	/* D7 — faixa de telas: grandes, lado a lado, rolando para o lado com encaixe. */
	.project-images {
		--shot-h: 520px;
	}

	.shots-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		margin-bottom: var(--space-5);
	}

	.shots-head h2 {
		margin: 0;
	}

	.shots-nav {
		display: none;
		gap: var(--space-2);
	}

	.is-scrollable .shots-nav {
		display: flex;
	}

	.shots-btn {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 0;
		border: 1px solid color-mix(in srgb, var(--text) 20%, transparent);
		border-radius: 6px;
		background: transparent;
		color: var(--text);
		cursor: pointer;
		transition:
			border-color var(--transition),
			opacity var(--transition),
			transform 160ms ease-out;
	}

	.shots-btn:hover:not(:disabled) {
		border-color: color-mix(in srgb, var(--text) 40%, transparent);
	}

	.shots-btn:active:not(:disabled) {
		transform: scale(0.97);
	}

	.shots-btn:disabled {
		opacity: 0.35;
		cursor: default;
	}

	.shots-btn svg {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.shots {
		display: flex;
		gap: var(--space-4);
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x mandatory;
		scrollbar-width: thin;
		padding-bottom: var(--space-3);
	}

	.shots:focus-visible {
		outline-offset: 4px;
	}

	.shot {
		flex: none;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		width: min-content;
		margin: 0;
		scroll-snap-align: start;
	}

	.shot figcaption {
		font-size: var(--text-sm);
		line-height: 1.45;
		color: var(--muted);
	}

	.shot-trigger {
		display: block;
		padding: 0;
		border: 0;
		border-radius: 8px;
		background: none;
		cursor: zoom-in;
	}

	.shot-trigger img {
		display: block;
		width: auto;
		height: var(--shot-h);
		max-width: none;
		border-radius: 8px;
		border: 1px solid var(--line);
		background: var(--surface);
		transition: opacity var(--transition);
	}

	.shot-trigger:hover img {
		opacity: 0.88;
	}

	.shot-trigger:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}

	@media (max-width: 700px) {
		.project-images {
			--shot-h: 420px;
		}

		/* No celular a faixa encosta nas bordas da tela; arrastar com o dedo basta. */
		.shots {
			margin-inline: calc(var(--space-5) * -1);
			padding-inline: var(--space-5);
			scroll-padding-inline: var(--space-5);
		}
	}

	.lightbox {
		width: 100vw;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: #fff;
		overflow: hidden;
	}

	.lightbox::backdrop {
		background: rgba(0, 0, 0, 0.95);
	}

	.lightbox-stage {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		padding: var(--space-8) var(--space-8);
		box-sizing: border-box;
		touch-action: pan-y;
	}

	.lightbox-img {
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
		border-radius: 6px;
		user-select: none;
		-webkit-user-drag: none;
	}

	.lightbox-counter {
		position: absolute;
		top: 1.25rem;
		left: 1.5rem;
		max-width: calc(100% - 6rem);
		margin: 0;
		font-size: var(--text-sm);
		font-weight: 600;
		color: rgba(255, 255, 255, 0.75);
	}

	.lightbox-btn {
		position: absolute;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		border: 0;
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.12);
		color: #fff;
		cursor: pointer;
		transition: background var(--transition);
	}

	.lightbox-btn:hover {
		background: rgba(255, 255, 255, 0.24);
	}

	.lightbox-btn:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 2px;
	}

	.lightbox-btn svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.lightbox-close {
		top: 0.75rem;
		right: 0.75rem;
	}

	.lightbox-prev,
	.lightbox-next {
		top: 50%;
		transform: translateY(-50%);
	}

	.lightbox-prev {
		left: 0.75rem;
	}

	.lightbox-next {
		right: 0.75rem;
	}

	@media (max-width: 640px) {
		.lightbox-stage {
			padding: var(--space-8) var(--space-3) var(--space-8);
		}

		.lightbox-prev,
		.lightbox-next {
			top: auto;
			bottom: 1rem;
			transform: none;
		}

		.lightbox-prev {
			left: calc(50% - 3.25rem);
		}

		.lightbox-next {
			right: calc(50% - 3.25rem);
		}
	}

	:global(html:has(dialog.lightbox[open])) {
		overflow: hidden;
	}
</style>
