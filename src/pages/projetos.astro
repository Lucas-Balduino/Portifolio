---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { META } from '../site-config';
import { getSortedProjects, projectMeta } from '../lib/projects';

const projects = await getSortedProjects();
---

<Layout title={META.projects.title} description={META.projects.description}>
	<section class="projects-list">
		<div class="section-head">
			<h1>Projetos</h1>
			<p class="muted">Cases de design e projetos de código.</p>
		</div>

		<div class="projects-list-grid">
			{
				projects.map((entry) => (
					<ProjectCard
						title={entry.data.title}
						slug={entry.data.slug}
						shortDesc={entry.data.short_desc}
						outcome={entry.data.outcome}
						image={entry.data.image}
						technologies={entry.data.technologies}
						meta={projectMeta(entry.data.summary)}
					/>
				))
			}
		</div>
	</section>
</Layout>
