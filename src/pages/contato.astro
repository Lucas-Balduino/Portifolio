---
import Layout from '../layouts/Layout.astro';
import ContactCta from '../components/ContactCta.astro';
import { META } from '../site-config';
---

<!-- E2 — sem formulário: email com copiar, LinkedIn e GitHub, como no fim da home. -->
<Layout title={META.contact.title} description={META.contact.description}>
	<div class="contact-page">
		<ContactCta
			page
			text="Procuro estágio em UX/UI e front-end e estou aberto a projetos freelance. Escreva sobre uma vaga, um projeto ou algum dos cases."
		/>
	</div>
</Layout>
