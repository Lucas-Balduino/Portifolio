---
import Layout from '../layouts/Layout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import ContactCta from '../components/ContactCta.astro';
import fotoMinha from '../../img/FotoMinha.jpg?url';
import { META } from '../site-config';
import { getSortedProjects, projectMeta, hoverScreen } from '../lib/projects';

const projects = await getSortedProjects();
const isFilled = (value?: string) => Boolean(value && value.trim() && value.trim() !== 'pendente');
---

<Layout title={META.home.title} description={META.home.description}>
	<section class="home-hero">
		<div class="home-hero-text">
			<h1 class="hero-title">Olá, eu sou Lucas</h1>
			<p class="home-role">Designer UX/UI e desenvolvedor front-end em formação</p>
			<p class="home-lead">
				Designer e desenvolvedor em formação (Design na UnB, Ciência da Computação no UniCEUB). Levo
				a interface do Figma até o app funcionando.
			</p>
			<div class="home-cta home-cta--hero">
				<a class="btn-project" href="#projetos">Ver projetos</a>
				<a class="btn ghost" href="/Resume/CurriculoPT.pdf" download>Baixar currículo</a>
			</div>
		</div>
		<figure class="home-photo">
			<img src={fotoMinha} alt="Foto do Lucas Balduino" width="320" height="320" />
		</figure>
	</section>

	<!-- C2 — resumo em uma faixa; as ferramentas ficam nos cases e no currículo. -->
	<dl class="home-strip" aria-label="Resumo">
		<div>
			<dt>Agora</dt>
			<dd>Bolsista no projeto de extensão Gêmeos Digitais · CAL/UnB</dd>
		</div>
		<div>
			<dt>Formação</dt>
			<dd>Design · UnB (previsão 2028) · Ciência da Computação · UniCEUB (previsão 2027)</dd>
		</div>
	</dl>

	<section class="home-projects" id="projetos">
		<div class="section-head">
			<h2>Projetos</h2>
			<a class="link-muted" href="/projetos">Ver lista →</a>
		</div>
		<div class="home-projects-list">
			{
				projects.map((entry, index) => (
					<ProjectRow
						title={entry.data.title}
						slug={entry.data.slug}
						description={
							isFilled(entry.data.outcome) ? entry.data.outcome! : entry.data.short_desc
						}
						image={entry.data.image}
						screen={hoverScreen(entry.data)}
						technologies={entry.data.technologies}
						meta={projectMeta(entry.data.summary)}
						reverse={index % 2 === 1}
						eager={index === 0}
					/>
				))
			}
		</div>
	</section>

	<ContactCta />
</Layout>

<style>
	.home-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
		align-items: center;
		gap: var(--space-7);
		padding: var(--space-6) 0 var(--space-6);
	}

	.home-hero .hero-title {
		margin: 0 0 var(--space-4);
		color: var(--text);
	}

	/* Cargo logo abaixo do título, discreto para não competir com ele. */
	.home-role {
		margin: 0 0 var(--space-5);
		font-size: var(--text-base);
		font-weight: 500;
		line-height: 1.4;
		color: var(--muted);
		text-wrap: balance;
	}

	/* Entrada em cascata do topo, uma vez por carregamento: 50ms entre itens. */
	.home-hero-text > *,
	.home-photo {
		animation: home-enter 600ms cubic-bezier(0.23, 1, 0.32, 1) both;
	}

	.home-hero-text > :nth-child(2) {
		animation-delay: 50ms;
	}

	.home-hero-text > :nth-child(3) {
		animation-delay: 100ms;
	}

	.home-hero-text > :nth-child(4) {
		animation-delay: 150ms;
	}

	.home-photo {
		animation-delay: 120ms;
	}

	@keyframes home-enter {
		from {
			opacity: 0;
			transform: translateY(8px);
			filter: blur(4px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home-hero-text > *,
		.home-photo {
			animation: none;
		}
	}

	.home-lead {
		max-width: 38rem;
		margin: 0 0 var(--space-6);
		font-size: var(--text-md);
		line-height: 1.6;
		color: var(--muted);
	}

	.home-cta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
	}

	/* Botões do hero com a mesma largura entre si (a do mais largo). */
	.home-cta--hero {
		display: inline-grid;
		grid-template-columns: 1fr 1fr;
	}

	.home-cta--hero > * {
		white-space: nowrap;
	}

	.home-photo {
		margin: 0;
		justify-self: end;
	}

	.home-photo img {
		display: block;
		width: 100%;
		max-width: 320px;
		height: auto;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 8px;
		border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);
	}

	/* C2 — faixa de resumo entre linhas finas: rótulo discreto + texto. */
	.home-strip {
		display: grid;
		grid-template-columns: max-content minmax(0, 1fr);
		gap: var(--space-2) var(--space-5);
		margin: 0;
		padding: var(--space-4) 0;
		border-block: 1px solid var(--line);
		font-size: var(--text-sm);
		line-height: 1.5;
	}

	.home-strip div {
		display: contents;
	}

	.home-strip dt {
		font-weight: 500;
		color: var(--muted);
	}

	.home-strip dd {
		margin: 0;
		color: var(--text);
	}

	.home-projects {
		margin-top: var(--space-7);
	}

	.home-projects .section-head h2 {
		margin: 0;
		font-size: var(--text-lg);
	}

	/* C4 — um projeto por linha, com bastante ar entre eles. */
	.home-projects-list {
		display: grid;
		gap: var(--space-8);
	}

	@media (max-width: 700px) {
		.home-hero {
			grid-template-columns: 1fr;
			gap: var(--space-6);
			padding-top: var(--space-6);
		}

		.home-photo {
			grid-row: 1;
			justify-self: start;
		}

		.home-photo img {
			max-width: 140px;
			border-radius: 8px;
		}

		.home-cta--hero {
			display: grid;
			width: 100%;
		}

		.home-projects-list {
			gap: var(--space-7);
		}

	}

	/* Celulares estreitos: lado a lado, "Baixar currículo" não cabe numa linha. */
	@media (max-width: 420px) {
		.home-cta--hero {
			grid-template-columns: 1fr;
		}
	}
</style>
