---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TechList from '../components/TechList.astro';
import fotoMinha from '../../img/FotoMinha.jpg?url';
import { META } from '../site-config';
import { getSortedProjects, projectMeta } from '../lib/projects';

const projects = await getSortedProjects();

// Mesma lista de competências de front-end/design do currículo.
const tools = ['Figma', 'HTML', 'CSS', 'JavaScript', 'React', 'React Native', 'Git', 'GitHub'];
---

<Layout title={META.home.title} description={META.home.description}>
	<section class="home-hero">
		<div class="home-hero-text">
			<h1 class="hero-title">Olá, eu sou Lucas</h1>
			<p class="home-role">Designer UX/UI e desenvolvedor front-end em formação</p>
			<p class="home-lead">
				Estudo Design na UnB e Ciência da Computação no UniCEUB. Trabalho com pesquisa, fluxos e
				interfaces centradas no usuário, com atenção à usabilidade e à acessibilidade.
			</p>
			<div class="home-cta home-cta--hero">
				<a class="btn-project" href="#projetos">Ver projetos</a>
				<a class="btn ghost" href="/Resume/CurriculoPT.pdf" download>Baixar currículo</a>
			</div>
		</div>
		<figure class="home-photo">
			<img src={fotoMinha} alt="Foto do Lucas Balduino" width="320" height="320" />
		</figure>
	</section>

	<section class="home-facts" aria-label="Resumo">
		<article class="fact">
			<h2 class="fact-label">Agora</h2>
			<p class="fact-main">Bolsista no projeto de extensão Gêmeos Digitais</p>
			<p class="fact-sub">CAL/UnB · escaneamento 3D de obras e site do acervo online</p>
		</article>
		<article class="fact">
			<h2 class="fact-label">Formação</h2>
			<p class="fact-main">Design · UnB</p>
			<p class="fact-sub">Previsão: 2028</p>
			<p class="fact-main">Ciência da Computação · UniCEUB</p>
			<p class="fact-sub">Previsão: 2027</p>
		</article>
		<article class="fact">
			<h2 class="fact-label">Ferramentas</h2>
			<TechList technologies={tools} variant="tools" />
		</article>
	</section>

	<section class="home-projects" id="projetos">
		<div class="section-head">
			<h2>Projetos</h2>
			<a class="link-muted" href="/projetos">Ver lista →</a>
		</div>
		<div class="home-projects-grid">
			{
				projects.map((entry, index) => (
					<ProjectCard
						title={entry.data.title}
						slug={entry.data.slug}
						shortDesc={entry.data.short_desc}
						image={entry.data.image}
						technologies={entry.data.technologies}
						meta={projectMeta(entry.data.summary)}
						featured={index === 0}
					/>
				))
			}
		</div>
	</section>

	<section class="home-contact">
		<div>
			<h2>Vamos conversar?</h2>
			<p class="muted">Sobre uma vaga, um projeto ou algum dos cases acima.</p>
		</div>
		<div class="home-cta">
			<a class="btn-project" href="/contato">Entrar em contato</a>
			<a
				class="btn ghost"
				href="https://www.linkedin.com/in/lucas-balduino-661073327"
				target="_blank"
				rel="noopener noreferrer">LinkedIn</a
			>
		</div>
	</section>
</Layout>

<style>
	.home-hero {
		/* Permite medir a largura da home (cqw) para alinhar os botões aos cards abaixo. */
		container-type: inline-size;
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
		align-items: center;
		gap: var(--space-7);
		padding: var(--space-8) 0 var(--space-7);
	}

	.home-hero .hero-title {
		margin: 0 0 var(--space-4);
		color: var(--text);
	}

	/* Cargo logo abaixo do título, discreto para não competir com ele. */
	.home-role {
		margin: 0 0 var(--space-5);
		font-size: var(--text-base);
		font-weight: 500;
		line-height: 1.4;
		color: var(--muted);
		text-wrap: balance;
	}

	/* Entrada em cascata do topo, uma vez por carregamento: 50ms entre itens. */
	.home-hero-text > *,
	.home-photo {
		animation: home-enter 600ms cubic-bezier(0.23, 1, 0.32, 1) both;
	}

	.home-hero-text > :nth-child(2) {
		animation-delay: 50ms;
	}

	.home-hero-text > :nth-child(3) {
		animation-delay: 100ms;
	}

	.home-hero-text > :nth-child(4) {
		animation-delay: 150ms;
	}

	.home-photo {
		animation-delay: 120ms;
	}

	@keyframes home-enter {
		from {
			opacity: 0;
			transform: translateY(8px);
			filter: blur(4px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home-hero-text > *,
		.home-photo {
			animation: none;
		}
	}

	.home-lead {
		max-width: 38rem;
		margin: 0 0 var(--space-6);
		font-size: var(--text-md);
		line-height: 1.6;
		color: var(--muted);
	}

	.home-cta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
	}

	/* Botões do hero com a mesma largura do card "Agora": 1/3 da grade de resumo (gap 1rem). */
	.home-cta--hero {
		display: grid;
		grid-template-columns: 1fr 1fr;
		width: calc((100cqw - 2rem) / 3);
		/* Se o card ficar estreito demais, os botões crescem em vez de quebrar o texto. */
		min-width: max-content;
	}

	.home-cta--hero > * {
		white-space: nowrap;
	}

	.home-photo {
		margin: 0;
		justify-self: end;
	}

	.home-photo img {
		display: block;
		width: 100%;
		max-width: 320px;
		height: auto;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 8px;
		border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);
	}

	.home-facts {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-4);
	}

	/* Ritmo entre seções: bem maior que o espaço dentro de cada uma. */
	.home-projects {
		margin-top: var(--rhythm-section);
	}

	.fact {
		padding: var(--space-5);
		border-radius: 8px;
		background: var(--surface);
		border: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
	}

	.fact-label {
		margin: 0 0 var(--space-3);
		font-family: inherit;
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0;
		color: var(--muted);
	}

	.fact-main {
		margin: 0;
		font-weight: 700;
		line-height: 1.4;
		color: var(--text);
	}

	.fact-sub {
		margin: var(--space-1) 0 var(--space-3);
		font-size: var(--text-sm);
		line-height: 1.45;
		color: var(--muted);
	}

	.fact-sub:last-child {
		margin-bottom: 0;
	}

	.home-projects .section-head h2 {
		margin: 0;
		font-size: var(--text-lg);
	}

	.home-projects-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-5);
	}

	.home-contact {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-5);
		margin: var(--rhythm-section) 0 var(--space-6);
		padding-top: var(--space-7);
		border-top: 1px solid var(--line);
	}

	.home-contact h2 {
		margin: 0 0 var(--space-2);
		font-size: var(--text-lg);
	}

	.home-contact p {
		margin: 0;
	}

	@media (max-width: 900px) {
		.home-facts,
		.home-projects-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.fact:last-child {
			grid-column: 1 / -1;
		}

		/* Grade de resumo em 2 colunas: card "Agora" = metade. */
		.home-cta--hero {
			width: calc((100cqw - 1rem) / 2);
		}
	}

	@media (max-width: 700px) {
		.home-hero {
			grid-template-columns: 1fr;
			gap: var(--space-6);
			padding-top: var(--space-6);
		}

		.home-photo {
			grid-row: 1;
			justify-self: start;
		}

		.home-photo img {
			max-width: 140px;
			border-radius: 8px;
		}

		.home-facts,
		.home-projects-grid {
			grid-template-columns: 1fr;
		}

		.home-cta--hero {
			width: 100%;
			min-width: 0;
		}

	}

	/* Celulares estreitos: lado a lado, "Baixar currículo" não cabe numa linha. */
	@media (max-width: 420px) {
		.home-cta--hero {
			grid-template-columns: 1fr;
		}
	}
</style>
