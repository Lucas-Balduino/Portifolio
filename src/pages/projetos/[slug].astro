---
import { getCollection } from 'astro:content';
import { micromark } from 'micromark';
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.astro';
import TechList from '../../components/TechList.astro';
import CaseSummary from '../../components/CaseSummary.astro';
import DesignSystem from '../../components/DesignSystem.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.data.slug },
		props: { project }
	}));
}

const { project } = Astro.props;
const data = project.data;
const body = (project.body ?? '').replace(/\r\n/g, '\n');

const splitH2Sections = (markdown: string) => {
	const sections: { title: string; markdown: string }[] = [];
	let current: { title: string; lines: string[] } | null = null;
	for (const line of markdown.split('\n')) {
		const heading = /^##\s+(.+)$/.exec(line);
		if (heading) {
			if (current) {
				sections.push({ title: current.title, markdown: current.lines.join('\n').trim() });
			}
			current = { title: heading[1].trim(), lines: [] };
		} else if (current) {
			current.lines.push(line);
		}
	}
	if (current) {
		sections.push({ title: current.title, markdown: current.lines.join('\n').trim() });
	}
	return sections.filter((section) => section.markdown.length > 0);
};

const toHtml = (markdown: string) => micromark(markdown, { allowDangerousHtml: true });
const publicSrc = (posixPath: string) => `/${posixPath.replace(/^\/+/, '')}`;

const mainIdeaTitle = data.section_titles?.main_idea ?? 'Ideia Principal';
const galleryTitle = data.section_titles?.images ?? 'Imagens';
const sections = splitH2Sections(body);
const gallerySrcs = new Set(data.gallery.map(publicSrc));

type Card = { title: string; html: string; image?: { src: string; alt: string; inGallery: boolean } };

const IMAGE_LINE = /^!\[([^\]]*)\]\(([^)\s]+)\)\s*$/;

/**
 * Seções com dois ou mais `###` viram uma grade de cards (um por subtítulo), em vez de texto corrido.
 * Uma linha de imagem `![alt](img/...)` dentro do subtítulo vira a imagem do card.
 * Blocos de código não são divididos.
 */
const splitCards = (markdown: string) => {
	const intro: string[] = [];
	const cards: { title: string; lines: string[] }[] = [];
	let inCode = false;
	for (const line of markdown.split('\n')) {
		if (/^```/.test(line)) inCode = !inCode;
		const heading = inCode ? null : /^###\s+(.+)$/.exec(line);
		if (heading) cards.push({ title: heading[1].trim(), lines: [] });
		else if (cards.length > 0) cards[cards.length - 1].lines.push(line);
		else intro.push(line);
	}
	if (cards.length < 2) return null;
	return {
		intro: toHtml(intro.join('\n').trim()),
		cards: cards.map(({ title, lines }): Card => {
			const imageIndex = lines.findIndex((line) => IMAGE_LINE.test(line.trim()));
			let image: Card['image'];
			if (imageIndex !== -1) {
				const [, alt, src] = IMAGE_LINE.exec(lines[imageIndex].trim())!;
				const normalized = publicSrc(src);
				image = { src: normalized, alt, inGallery: gallerySrcs.has(normalized) };
				lines.splice(imageIndex, 1);
			}
			return { title, html: toHtml(lines.join('\n').trim()), image };
		})
	};
};

type Block =
	| { type: 'section'; title: string; html: string; intro?: string; cards?: Card[] }
	| { type: 'design' }
	| { type: 'gallery' };

// Painel do design system e galeria entram logo depois da ideia principal.
const visualBlocks: Block[] = [
	...(data.design_system ? [{ type: 'design' } as const] : []),
	...(data.gallery.length > 0 ? [{ type: 'gallery' } as const] : [])
];

const blocks: Block[] = [];
for (const section of sections) {
	const split = splitCards(section.markdown);
	blocks.push(
		split
			? { type: 'section', title: section.title, html: '', intro: split.intro, cards: split.cards }
			: { type: 'section', title: section.title, html: toHtml(section.markdown) }
	);
	if (section.title === mainIdeaTitle) blocks.push(...visualBlocks);
}
if (visualBlocks.length > 0 && !blocks.some((block) => block.type !== 'section')) {
	const firstSection = blocks.findIndex((block) => block.type === 'section');
	blocks.splice(firstSection === -1 ? 0 : firstSection + 1, 0, ...visualBlocks);
}

const coverSrc = publicSrc(data.image);
---

<Layout
	title={`${data.title} — Lucas`}
	description={data.short_desc}
	ogImage={publicSrc(data.image)}
>
	<article class="project-detail">
		<header class="project-hero">
			<div class="project-hero-row">
				<div>
					<h1>{data.title}</h1>
					<p class="muted">{data.short_desc}</p>
				</div>
				<a href="/projetos" class="btn ghost">← Voltar para projetos</a>
			</div>
		</header>

		<CaseSummary
			summary={data.summary}
			technologies={data.technologies}
			repoUrl={data.repo_url}
			liveUrl={data.live_url}
		/>

		{
			data.image && (
				<section class="project-image">
					<img class="project-hero-img" src={coverSrc} alt={data.title} loading="lazy" />
				</section>
			)
		}

		{
			blocks.map((block) =>
				block.type === 'gallery' ? (
					<Gallery title={data.title} heading={galleryTitle} images={data.gallery} />
				) : block.type === 'design' && data.design_system ? (
					<DesignSystem
						heading={data.design_system.title ?? 'Design System'}
						colors={data.design_system.colors}
						fonts={data.design_system.fonts}
						link={data.design_system.link}
					/>
				) : block.type === 'section' ? (
					<section class="project-section">
						<h2>{block.title}</h2>
						{block.cards ? (
							<>
								{block.intro && <div class="project-rich-text case-intro" set:html={block.intro} />}
								<div
									class:list={[
										'case-cards',
										block.cards.some((card) => card.html.includes('<pre'))
											? 'case-cards--stack'
											: { 'case-cards--pairs': block.cards.length === 2 || block.cards.length === 4 }
									]}
								>
									{block.cards.map((card) => (
										<article class:list={['case-card', { 'case-card--media': card.image }]}>
											{card.image &&
												(card.image.inGallery ? (
													<button
														type="button"
														class="case-card-media"
														data-open-in-gallery={card.image.src}
														aria-label={`Ampliar imagem: ${card.image.alt || card.title}`}
													>
														<img src={card.image.src} alt={card.image.alt} loading="lazy" />
													</button>
												) : (
													<div class="case-card-media">
														<img src={card.image.src} alt={card.image.alt} loading="lazy" />
													</div>
												))}
											<div class="case-card-body">
												<h3>{card.title}</h3>
												<div class="project-rich-text" set:html={card.html} />
											</div>
										</article>
									))}
								</div>
							</>
						) : (
							<div class="project-rich-text" set:html={block.html} />
						)}
					</section>
				) : null
			)
		}

		{
			data.technologies.length > 0 && (
				<section class="project-technologies">
					<h2>Tecnologias</h2>
					<TechList technologies={data.technologies} />
				</section>
			)
		}

	</article>
</Layout>

<script>
	// Botão "Copiar" em cada bloco de código do case.
	const COPY_ICON =
		'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
	const CHECK_ICON =
		'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';

	const copyText = async (text: string) => {
		try {
			await navigator.clipboard.writeText(text);
			return true;
		} catch {
			// Sem acesso à área de transferência (ex.: http): copia por seleção.
			const area = document.createElement('textarea');
			area.value = text;
			area.setAttribute('readonly', '');
			area.style.position = 'fixed';
			area.style.opacity = '0';
			document.body.append(area);
			area.select();
			const ok = document.execCommand('copy');
			area.remove();
			return ok;
		}
	};

	for (const pre of document.querySelectorAll<HTMLPreElement>('.project-detail pre')) {
		const code = pre.querySelector('code') ?? pre;
		const text = code.textContent?.trimEnd() ?? '';
		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'code-copy';
		const setState = (copied: boolean) => {
			button.innerHTML = copied ? CHECK_ICON : COPY_ICON;
			button.dataset.tip = copied ? 'Copiado' : 'Copiar';
			button.setAttribute('aria-label', copied ? 'Comandos copiados' : 'Copiar comandos');
			button.toggleAttribute('data-copied', copied);
		};
		setState(false);
		let timer: number | undefined;
		button.addEventListener('click', async () => {
			if (!(await copyText(text))) return;
			setState(true);
			window.clearTimeout(timer);
			timer = window.setTimeout(() => setState(false), 2000);
		});
		pre.append(button);
	}
</script>

<style>
	.case-intro {
		margin-bottom: 1.25rem;
	}

	/* Subtítulos da seção lado a lado, em vez de texto corrido. */
	.case-cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
		gap: 1rem;
	}

	/* 2 ou 4 cards: duas colunas, para não sobrar um card sozinho na linha. */
	@media (min-width: 640px) {
		.case-cards--pairs {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	/* Cards com comandos (ex.: Como executar): um por linha, para o código ter a largura toda. */
	.case-cards--stack {
		grid-template-columns: minmax(0, 1fr);
	}

	.case-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border-radius: 8px;
		background: var(--bg);
		border: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
	}

	.case-card-body {
		padding: 1.1rem 1.15rem 1.2rem;
	}

	.case-card h3 {
		margin: 0 0 0.5rem;
		font-size: 1.05rem;
		line-height: 1.3;
		letter-spacing: -0.01em;
		color: var(--text);
	}

	.case-card .project-rich-text {
		font-size: 0.95rem;
		line-height: 1.6;
	}

	/* O card já usa o fundo da página; o código precisa de outro tom para se destacar. */
	.case-card :global(code),
	.case-card :global(pre) {
		background: var(--surface);
	}

	.case-card :global(pre code) {
		background: transparent;
	}

	/* Linhas longas quebram em vez de cortar; copiar continua levando o comando inteiro. */
	.project-detail :global(pre) {
		position: relative;
		padding-right: 3.25rem;
	}

	.project-detail :global(pre code) {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}

	/* Só o ícone no canto; o hover mostra "Copiar" (e "Copiado" depois do clique). */
	.project-detail :global(.code-copy) {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		padding: 0;
		border: 0;
		border-radius: 6px;
		background: transparent;
		color: var(--muted);
		cursor: pointer;
		transition:
			color 150ms ease,
			background-color 150ms ease,
			transform 160ms ease-out;
	}

	.project-detail :global(.code-copy:hover),
	.project-detail :global(.code-copy:focus-visible),
	.project-detail :global(.code-copy[data-copied]) {
		color: var(--text);
		background: color-mix(in srgb, var(--text) 10%, transparent);
	}

	.project-detail :global(.code-copy:active) {
		transform: scale(0.97);
	}

	.project-detail :global(.code-copy svg) {
		width: 16px;
		height: 16px;
	}

	/* Dica à esquerda do ícone, dentro do bloco (o pre corta o que sai dele). */
	.project-detail :global(.code-copy::after) {
		content: attr(data-tip);
		position: absolute;
		top: 50%;
		right: calc(100% + 6px);
		padding: 0.2rem 0.45rem;
		border-radius: 4px;
		background: var(--text);
		color: var(--bg);
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 0.72rem;
		font-weight: 600;
		white-space: nowrap;
		pointer-events: none;
		opacity: 0;
		transform: translate(4px, -50%);
		transition:
			opacity 150ms ease,
			transform 150ms ease;
	}

	.project-detail :global(.code-copy:hover::after),
	.project-detail :global(.code-copy:focus-visible::after),
	.project-detail :global(.code-copy[data-copied]::after) {
		opacity: 1;
		transform: translate(0, -50%);
	}

	.case-card-media {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 240px;
		padding: 0.75rem;
		border: 0;
		background: color-mix(in srgb, var(--text) 5%, transparent);
		color: inherit;
		font: inherit;
	}

	button.case-card-media {
		cursor: zoom-in;
	}

	button.case-card-media:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: -2px;
	}

	.case-card-media img {
		display: block;
		max-width: 100%;
		max-height: 100%;
		object-fit: contain;
		border-radius: 6px;
		transition: transform 300ms ease;
	}

	button.case-card-media:hover img {
		transform: scale(1.03);
	}
</style>
